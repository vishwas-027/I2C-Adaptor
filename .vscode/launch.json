{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "STM32F411 Debug",
            "type": "cortex-debug",
            "request": "launch",

            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/build/firmware.elf",

            "servertype": "openocd",

            "gdbPath": "arm-none-eabi-gdb",

            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],

            "device": "STM32F411CE",

            "interface": "swd",

            "runToEntryPoint": "main",

            "svdFile": "${workspaceFolder}/board/STM32F411.svd",

            "preLaunchTask": "build",

            "postRestartCommands": [
                "monitor reset halt"
            ],

            "showDevDebugOutput": "raw"
        }
    ]
}